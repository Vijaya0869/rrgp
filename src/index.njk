---
permalink: /index.html
layout: base.njk
---
{%- set s = settings -%}
{%- set h = home -%}
{%- macro sechead(num, label) -%}
<div class="sechead" data-reveal>{% if num %}<span class="secnum">{{ num }}</span>{% endif %}<span class="seclabel">{{ label }}</span></div>
{%- endmacro -%}

  <section id="top" class="hero">
    {%- if h.hero.image %}
    {% heroImage h.hero.image, h.hero.image_alt %}
    {%- endif %}
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-in">
      <div class="hero-k" data-in>{{ s.tagline }}</div>
      <h1 class="hero-title" data-in>{{ h.hero.title }}</h1>
      <div class="hero-ctas" data-in>
        <a class="btn btn-primary" href="#capital">{{ h.hero.primary_button }}</a>
        <a class="btn btn-ghost" href="#process">{{ h.hero.secondary_button }}</a>
      </div>
      {%- if h.hero.show_featured and h.hero.featured_project %}
      <div class="hero-feat" data-in>
        <span class="hero-feat-k">{{ h.hero.featured_label }}</span>
        <span>{{ h.hero.featured_project }}</span>
      </div>
      {%- endif %}
    </div>
  </section>

  <section class="intro tone-light">
    <div class="sec intro-in">
      <p class="intro-lede" data-reveal>{{ h.hero.intro }}</p>
      <div class="facts" data-reveal-group>
        {%- for x in h.hero.highlights %}
        <div class="fact"><div class="fact-t">{{ x.title }}</div><div class="fact-c">{{ x.caption }}</div></div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section id="what" class="tone-navy">
    <div class="sec">
      <div class="head-row">
        {{ sechead("01", h.platform.label) }}
        <div>
          <h2 class="h2" data-reveal>{{ h.platform.heading }}</h2>
          <p class="lede" data-reveal>{{ h.platform.lede }}</p>
        </div>
      </div>
      <div class="biz" data-reveal-group>
        {%- asyncEach b in h.platform.businesses %}
        <article class="biz-card">
          <div class="biz-img">{% picture b.image, b.title, "(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 25vw" %}</div>
          <div class="biz-k">{{ loop.index | pad }} · {{ b.verb }}</div>
          <h3 class="biz-t">{{ b.title }}</h3>
          <p class="biz-b">{{ b.body }}</p>
        </article>
        {%- endeach %}
      </div>

      <div id="process" class="process">
        <div class="head-row head-row-tight">
          <div class="seclabel" data-reveal>{{ h.approach.label }}</div>
          <div>
            <h3 class="h3" data-reveal>{{ h.approach.heading }}</h3>
            <p class="lede" data-reveal>{{ h.approach.lede }}</p>
          </div>
        </div>
        <ol class="tl" data-tl>
          {%- for st in h.approach.steps %}
          <li class="tl-step" style="--i: {{ loop.index0 }}">
            <span class="tl-node" aria-hidden="true">{{ loop.index | pad }}</span>
            <span class="tl-t">{{ st.title }}</span>
            <span class="tl-b">{{ st.body }}</span>
          </li>
          {%- endfor %}
        </ol>
      </div>

      {%- if h.quote %}
      <blockquote class="pull" data-reveal><p>{{ h.quote }}</p></blockquote>
      {%- endif %}
    </div>
  </section>

  <section id="focus" class="tone-light">
    <div class="sec">
      <div class="head-row">
        {{ sechead("02", h.mandate.label) }}
        <div>
          <h2 class="h2" data-reveal>{{ h.mandate.heading }}</h2>
          <p class="lede" data-reveal>{{ h.mandate.lede }}</p>
        </div>
      </div>
      <div class="k" data-reveal>{{ h.mandate.invest_label }}</div>
      <div class="four" data-reveal-group>
        {%- for x in h.mandate.invest %}
        <div class="cell"><div class="cell-n">{{ loop.index | pad }}</div><h4 class="cell-t">{{ x.title }}</h4><p class="cell-b">{{ x.body }}</p></div>
        {%- endfor %}
      </div>
      <div class="split">
        <div>
          <div class="k" data-reveal>{{ h.mandate.deliver_label }}</div>
          <div class="two-cells" data-reveal-group>
            {%- for x in h.mandate.deliver %}
            <div class="cell"><h4 class="cell-t">{{ x.title }}</h4><p class="cell-b">{{ x.body }}</p></div>
            {%- endfor %}
          </div>
        </div>
        <div data-reveal>
          <div class="k">{{ h.mandate.pass_label }}</div>
          <ul class="pass">
            {%- for x in h.mandate.pass %}<li>{{ x }}</li>{%- endfor %}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="record" class="tone-white">
    <div class="sec">
      <div class="head-row">
        {{ sechead("03", h.portfolio.label) }}
        <div>
          <h2 class="h2" data-reveal>{{ h.portfolio.heading }}</h2>
          <p class="lede" data-reveal>{{ h.portfolio.lede }}</p>
        </div>
      </div>
      {%- set shown = projects.items | visible %}
      {%- if shown.length %}
      <div class="proj" data-reveal-group>
        {%- asyncEach p in shown %}
        <article class="proj-card">
          <div class="proj-img">{% picture p.image, p.name, "(max-width: 940px) 100vw, 33vw" %}</div>
          <h3 class="proj-t">{{ p.name }}</h3>
          <div class="proj-k">{{ p.city }}{% if p.category %} · {{ p.category }}{% endif %}</div>
        </article>
        {%- endeach %}
      </div>
      {%- endif %}
      <div class="tbl-head" data-reveal>
        <span class="k k-strong">{{ h.portfolio.table_label }}</span>
        <span class="k">{{ h.portfolio.table_note }}</span>
      </div>
      <div class="arow arow-head" data-reveal>
        <span class="k">Strategy</span><span class="k">Market</span><span class="k">Focus</span><span class="k">Status</span>
      </div>
      <div data-reveal-group>
        {%- for r in h.portfolio.rows %}
        <div class="arow">
          <span class="arow-s">{{ r.strategy }}</span>
          <span>{{ r.market }}</span>
          <span>{{ r.focus }}</span>
          <span class="k {{ 'k-gold' if r.highlight else 'k-strong' }}">{{ r.status }}</span>
        </div>
        {%- endfor %}
      </div>

      {%- if h.portfolio.markets and h.portfolio.markets.length %}
      <div class="mkts" data-reveal>
        <svg class="ohio" viewBox="-12 -12 {{ ohio.width + 24 }} {{ ohio.height + 24 }}" role="img" aria-labelledby="ohio-t">
          <title id="ohio-t">Map of Ohio marking the markets we serve: {{ h.portfolio.markets | join(", ") }}</title>
          <path class="ohio-land" d="{{ ohio.path }}"/>
          {%- for m in h.portfolio.markets %}
          {%- set p = ohio.dot(m) %}
          {%- if p %}<circle class="ohio-halo" cx="{{ p[0] }}" cy="{{ p[1] }}" r="11"/><circle class="ohio-dot" cx="{{ p[0] }}" cy="{{ p[1] }}" r="5"/>{% endif %}
          {%- endfor %}
        </svg>
        <div>
          <div class="k">Markets we serve</div>
          <ul class="mkt-list">
            {%- for m in h.portfolio.markets %}<li>{{ m }}</li>{%- endfor %}
          </ul>
          <p class="note">{{ h.portfolio.footnote }}</p>
        </div>
      </div>
      {%- endif %}
    </div>
  </section>

  {%- if h.marketplace.show %}
  <section id="market" class="tone-light">
    <div class="sec">
      <div class="head-row">
        <div class="sechead" data-reveal><span class="seclabel">{{ h.marketplace.label }}</span>{% if h.marketplace.badge %}<span class="soon soon-lg">{{ h.marketplace.badge }}</span>{% endif %}</div>
        <div>
          <h2 class="h2" data-reveal>{{ h.marketplace.heading }}</h2>
          <p class="lede" data-reveal>{{ h.marketplace.lede }}</p>
        </div>
      </div>
      <div class="mk-grid" data-reveal-group>
        {%- asyncEach c in h.marketplace.cards %}
        <article class="mk{% if c.image %} mk-has-img{% endif %}">
          {%- if c.image %}<div class="mk-img">{% picture c.image, c.title, "(max-width: 940px) 100vw, 33vw" %}</div>{% endif %}
          <div class="mk-body">
            <div class="k k-gold">{{ c.kicker }}</div>
            <h3 class="mk-t">{{ c.title }}</h3>
            <p class="mk-b">{{ c.body }}</p>
            <span class="k">{{ c.status }}</span>
          </div>
        </article>
        {%- endeach %}
      </div>
      <div class="notify" data-reveal>
        <div>
          <h3 class="h4">{{ h.marketplace.notify_heading }}</h3>
          <p class="cell-b">{{ h.marketplace.notify_body }}</p>
        </div>
        <form data-notify-form data-endpoint="{{ s.waitlist_endpoint or s.form_endpoint }}" data-fallback="{{ s.email }}" novalidate>
          <div class="notify-row">
            <div class="dfield"><label for="mk-email">Email address</label><input id="mk-email" name="email" type="email" autocomplete="email" required></div>
            <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true">
            <button class="dsubmit" type="submit">Notify me</button>
          </div>
          <p class="dstatus" data-notify-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
  {%- endif %}

  {%- if h.partners.show %}
  <section id="partners" class="tone-navy">
    <div class="sec">
      <div class="head-row">
        <div class="sechead" data-reveal><span class="seclabel">{{ h.partners.label }}</span></div>
        <div data-reveal>
          <h2 class="h2">{{ h.partners.heading }}</h2>
          <p class="lede">{{ h.partners.body }}</p>
          <div class="btns">
            <a class="btn btn-primary" href="#capital">{{ h.partners.primary_button }}</a>
            {%- if s.jr_capital_url %}
            <a class="btn btn-ghost" href="{{ s.jr_capital_url }}" target="_blank" rel="noopener">{{ h.partners.secondary_button }}</a>
            {%- endif %}
          </div>
        </div>
      </div>
    </div>
  </section>
  {%- endif %}

  <section id="who" class="tone-light">
    <div class="sec">
      <div class="head-row">
        {{ sechead("04", h.leadership.label) }}
        <div>
          <h2 class="h2" data-reveal>{{ h.leadership.heading }}</h2>
          <p class="lede" data-reveal>{{ h.leadership.lede }}</p>
        </div>
      </div>
      <div class="people" data-reveal-group>
        {%- for p in h.leadership.people %}
        <article class="person">
          <h3 class="person-n">{{ p.name }}</h3>
          <div class="k k-gold">{{ p.role }}</div>
          <p class="cell-b">{{ p.bio }}</p>
          {%- if p.background %}<p class="person-bg">{{ p.background }}</p>{% endif %}
        </article>
        {%- endfor %}
      </div>
      {%- if h.leadership.team %}
      <div class="team" data-reveal>
        <span class="k">{{ h.leadership.team_label }}</span>
        <span class="cell-b">{{ h.leadership.team }}</span>
      </div>
      {%- endif %}
    </div>
  </section>

  <section id="capital" class="tone-white contact">
    <div class="sec">
      <div class="contact-panel">
        <div>
          {{ sechead("05", "Contact") }}
          <h2 class="h2 h2-lg" data-reveal>{{ h.contact.heading }}</h2>
          <p class="lede" data-reveal>{{ h.contact.body }}</p>

          <form class="dform" data-deal-form data-endpoint="{{ s.form_endpoint }}" data-fallback="{{ s.email }}" data-reveal>
            <div class="dfield dfield-wide">
              <label for="cf-role">I am a</label>
              <select id="cf-role" name="role">
                {%- for o in h.contact.roles %}<option>{{ o }}</option>{%- endfor %}
              </select>
            </div>
            <div class="dfield"><label for="cf-first">First name <span class="req" aria-hidden="true">*</span></label><input id="cf-first" name="first" type="text" autocomplete="given-name" required></div>
            <div class="dfield"><label for="cf-last">Last name <span class="req" aria-hidden="true">*</span></label><input id="cf-last" name="last" type="text" autocomplete="family-name" required></div>
            <div class="dfield"><label for="cf-email">Email <span class="req" aria-hidden="true">*</span></label><input id="cf-email" name="email" type="email" autocomplete="email" required></div>
            <div class="dfield"><label for="cf-phone">Phone</label><input id="cf-phone" name="phone" type="tel" autocomplete="tel"></div>
            <div class="dfield dfield-wide"><label for="cf-addr">Property address <span class="req" aria-hidden="true">*</span></label><input id="cf-addr" name="address" type="text" required></div>
            <div class="dfield">
              <label for="cf-ptype">Property type</label>
              <select id="cf-ptype" name="propertyType">
                {%- for o in h.contact.property_types %}<option>{{ o }}</option>{%- endfor %}
              </select>
            </div>
            <div class="dfield"><label for="cf-price">Asking price</label><input id="cf-price" name="price" type="text" inputmode="numeric" placeholder="$" data-currency></div>
            <div class="dfield dfield-wide"><label for="cf-note">Tell us about the opportunity</label><textarea id="cf-note" name="note" rows="4"></textarea></div>
            <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true">
            <div class="dform-foot">
              <span class="dnote">Fields marked <span class="req">*</span> are required.{% if s.response_time %} We respond to every submission within {{ s.response_time }}.{% endif %}</span>
              <button class="dsubmit" type="submit" data-submit>{{ h.contact.submit_label }} <span class="dsubmit-arrow" aria-hidden="true">→</span></button>
              <p class="dstatus" data-status role="status" aria-live="polite"></p>
              {%- if s.email %}
              <a class="dmail" href="mailto:{{ s.email }}?subject={{ ('Deal submission — ' + s.company) | urlencode }}">Prefer email? {{ s.email }} →</a>
              {%- endif %}
            </div>
          </form>
          <div class="dsent" data-sent tabindex="-1" hidden>
            <span class="dsent-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2.4" d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
            <h3 class="h4">Submission received</h3>
            <p class="cell-b">{{ h.contact.success_message }}</p>
          </div>
        </div>

        <aside class="contact-aside" data-reveal>
          <div class="k k-gold">{{ h.contact.aside_label }}</div>
          {%- if s.email %}
          <div class="crow"><span class="k">Email</span><a href="mailto:{{ s.email }}">{{ s.email }}</a></div>
          {%- endif %}
          {%- if s.phone %}
          <div class="crow"><span class="k">Phone</span><a href="tel:{{ s.phone | tel }}">{{ s.phone }}</a></div>
          {%- endif %}
          <div class="crow"><span class="k">Office</span><span>{{ s.address }}</span></div>
          <div class="crow"><span class="k">Focus</span><span>{{ s.focus }}</span></div>
          {%- if s.jr_capital_url %}
          <div class="crow"><span class="k">Capital arm</span><a href="{{ s.jr_capital_url }}" target="_blank" rel="noopener">JR Capital →</a></div>
          {%- endif %}
        </aside>
      </div>
    </div>
  </section>
